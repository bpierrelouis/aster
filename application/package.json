{
  "name": "orion",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n serveur,interface,postes \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:postes\"",
    "dev:postes": "node --env-file-if-exists=.env backend/demonstrateur/agents.ts",
    "dev:backend": "node --watch --env-file-if-exists=.env backend/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env backend/start-production.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "test": "node --test \"backend/**/*.test.ts\"",
    "test:ui": "playwright test tests/login-ui.spec.ts",
    "test:e2e": "playwright test tests/auth.e2e.spec.ts",
    "test:workspace": "playwright test -c playwright.workspace.config.ts",
    "dev:ui": "vite --config frontend/vite.config.ts --mode ui --host 127.0.0.1",
    "dev:recon": "concurrently -k -n relais,mobile,connecteur \"npm run dev:relais\" \"npm run dev:mobile\" \"npm run dev:connecteur\"",
    "dev:relais": "node --watch backend/recon/relais-start.ts",
    "dev:mobile": "vite --config frontend/vite.recon.config.ts --host 127.0.0.1",
    "dev:connecteur": "node --env-file-if-exists=.env backend/recon/connecteur.ts",
    "build:recon": "vite build --config frontend/vite.recon.config.ts",
    "start:relais": "node backend/recon/relais-start.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p frontend/tsconfig.json"
  },
  "dependencies": {
    "barcode-detector": "3.2.3",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "swagger-ui-express": "5.0.1",
    "tesseract.js": "7.0.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/swagger-ui-express": "4.1.8",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "9.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
