{
  "name": "aster",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n serveur,interface,postes \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:postes\"",
    "dev:postes": "node --env-file-if-exists=.env backend/agents.js",
    "dev:backend": "node --watch --env-file-if-exists=.env backend/index.js",
    "dev:frontend": "vite --config frontend/vite.config.js --host 127.0.0.1",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node --env-file-if-exists=.env backend/start-production.js",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "test": "node --test backend/*.test.js",
    "test:ui": "playwright test tests/login-ui.spec.js",
    "test:e2e": "playwright test tests/auth.e2e.spec.js",
    "test:workspace": "playwright test -c playwright.workspace.config.js",
    "dev:ui": "vite --config frontend/vite.config.js --mode ui --host 127.0.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.9",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "vite": "^8.3.6"
  }
}
