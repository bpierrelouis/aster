{
  "realm": "aster-demo",
  "displayName": "ASTER — Démonstrateur local",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "aster-mindef",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Super administrateur"
      },
      {
        "name": "admin",
        "description": "Administrateur"
      },
      {
        "name": "gestionnaire",
        "description": "Gestionnaire"
      },
      {
        "name": "formateur",
        "description": "Formateur"
      }
    ]
  },
  "users": [
    {
      "username": "superadmin",
      "email": "superadmin@aster.demo",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Super administrateur",
      "requiredActions": [],
      "realmRoles": [
        "super_admin"
      ],
      "credentials": [],
      "lastName": "ASTER"
    },
    {
      "username": "admin",
      "email": "admin@aster.demo",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Administrateur",
      "requiredActions": [],
      "realmRoles": [
        "admin"
      ],
      "credentials": [],
      "lastName": "ASTER"
    },
    {
      "username": "gestionnaire",
      "email": "gestionnaire@aster.demo",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Gestionnaire",
      "requiredActions": [],
      "realmRoles": [
        "gestionnaire"
      ],
      "credentials": [],
      "lastName": "ASTER"
    },
    {
      "username": "formateur",
      "email": "formateur@aster.demo",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Formateur",
      "requiredActions": [],
      "realmRoles": [
        "formateur"
      ],
      "credentials": [],
      "lastName": "ASTER"
    }
  ],
  "clients": [
    {
      "clientId": "aster-web",
      "name": "ASTER",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "aster-demo-client-local",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "aster-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "aster_roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true
    }
  ],
  "browserFlow": "aster-demo-username-only",
  "authenticationFlows": [
    {
      "alias": "aster-demo-username-only",
      "description": "LOCAL DEMO ONLY: known usernames without a password. Never deploy in production.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
