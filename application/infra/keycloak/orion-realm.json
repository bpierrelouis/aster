{
  "realm": "orion",
  "displayName": "Orion — Environnement local",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "orion-mindef",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 3600,
  "users": [
    {
      "username": "service-account-orion-provisionnement",
      "enabled": true,
      "serviceAccountClientId": "orion-provisionnement",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "orion-provisionnement",
      "name": "Création des identités (démonstrateur)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PROVISIONING_CLIENT_SECRET:orion-provisionnement-local}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "orion-web",
      "name": "ORION",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET:orion-client-local}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${APP_URL:http://localhost:5173}/auth/callback"
      ],
      "webOrigins": [
        "${APP_URL:http://localhost:5173}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_URL:http://localhost:5173}/##${APP_URL:http://localhost:5173}/auth/login"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "fullScopeAllowed": true
    }
  ],
  "browserFlow": "orion-connexion-${ORION_COMPTES_PRESENTATION:false}",
  "authenticationFlows": [
    {
      "alias": "orion-connexion-false",
      "description": "Adresse électronique, puis mot de passe.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "orion-connexion-true",
      "description": "Présentation au client (ORION_COMPTES_PRESENTATION=true) : mot de passe demandé, sauf aux comptes des jetons « Accès de présentation ». Jamais en production.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "orion-mot-de-passe-hors-presentation",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "orion-mot-de-passe-hors-presentation",
      "description": "Mot de passe, sauf pour les comptes des jetons « Accès de présentation » (mêmes adresses que le thème orion-mindef).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-attribute",
          "authenticatorConfig": "orion-comptes-presentation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "orion-comptes-presentation",
      "config": {
        "attribute_name": "email",
        "attribute_expected_value": "^(julien\\.mercier@outlook\\.fr|sophie\\.garnier@yahoo\\.fr|thomas\\.lefebvre@hotmail\\.fr)$",
        "regex": "true",
        "not": "true",
        "include_group_attributes": "false"
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "orion-annuaire-ldap",
        "name": "annuaire-orion",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "username"
                ],
                "ldap.attribute": [
                  "uid"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "firstName"
                ],
                "ldap.attribute": [
                  "givenName"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "lastName"
                ],
                "ldap.attribute": [
                  "sn"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "email"
                ],
                "ldap.attribute": [
                  "mail"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "full name",
              "providerId": "full-name-ldap-mapper",
              "config": {
                "ldap.full.name.attribute": [
                  "cn"
                ],
                "read.only": [
                  "false"
                ],
                "write.only": [
                  "true"
                ]
              }
            }
          ]
        },
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "other"
          ],
          "editMode": [
            "WRITABLE"
          ],
          "usePasswordModifyExtendedOp": [
            "true"
          ],
          "importEnabled": [
            "false"
          ],
          "syncRegistrations": [
            "true"
          ],
          "trustEmail": [
            "true"
          ],
          "connectionUrl": [
            "ldap://ldap:389"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "cn=admin,dc=orion,dc=demo"
          ],
          "bindCredential": [
            "${LDAP_ADMIN_PASSWORD:ldap-admin-local}"
          ],
          "usersDn": [
            "ou=people,dc=orion,dc=demo"
          ],
          "searchScope": [
            "1"
          ],
          "userObjectClasses": [
            "inetOrgPerson, organizationalPerson"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "uid"
          ],
          "uuidLDAPAttribute": [
            "entryUUID"
          ],
          "pagination": [
            "false"
          ],
          "cachePolicy": [
            "DEFAULT"
          ],
          "fullSyncPeriod": [
            "-1"
          ],
          "changedSyncPeriod": [
            "-1"
          ],
          "validatePasswordPolicy": [
            "false"
          ]
        }
      }
    ]
  }
}
