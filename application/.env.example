# Démonstrateur local uniquement. Les valeurs correspondent à compose.yaml.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DATABASE_URL=postgres://aster:aster-local@localhost:5432/aster
OIDC_ISSUER=http://localhost:8081/realms/aster
OIDC_CLIENT_ID=aster-web
OIDC_CLIENT_SECRET=aster-client-local
# Facultatif en développement ; obligatoire (32 caractères minimum) en production.
# SESSION_SECRET=
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=aster-etats-des-lieux
S3_ACCESS_KEY=aster
S3_SECRET_KEY=aster-local-s3
# Jeton des postes (API /api/agent)
AGENT_TOKEN=aster-agent-local
# Démonstrateur : administration du Keycloak local pour créer les identités des comptes ASTER
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-local
