# Démonstrateur local uniquement. Les valeurs correspondent à compose.yaml.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DATABASE_URL=postgres://orion:orion-local@localhost:5432/orion
OIDC_ISSUER=http://localhost:8081/realms/orion
OIDC_CLIENT_ID=orion-web
OIDC_CLIENT_SECRET=orion-client-local
# Facultatif en développement ; obligatoire (32 caractères minimum) en production.
# SESSION_SECRET=
# Jeton des postes (API /api/agent)
AGENT_TOKEN=orion-agent-local
# Démonstrateur : administration du Keycloak local pour créer les identités des comptes ORION
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-local
