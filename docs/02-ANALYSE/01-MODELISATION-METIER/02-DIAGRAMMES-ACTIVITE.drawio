ometry"/></mxCell><mxCell id="n_profil" value="Super administrateur ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="115" y="347" width="170" height="57" as="geometry"/></mxCell><mxCell id="n_ecole" value="Choisir l&#x27;école affichée&lt;br&gt;ou toutes les écoles" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="346" y="351.5" width="148" height="48" as="geometry"/></mxCell><mxCell id="n_fusion" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="184" y="444" width="32" height="32" as="geometry"/></mxCell><mxCell id="n_choix" value="Choisir une activité accessible&lt;br&gt;selon son profil" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="105" y="500" width="190" height="48" as="geometry"/></mxCell><mxCell id="n_activite" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="184" y="572" width="32" height="32" as="geometry"/></mxCell><mxCell id="n_personnel" value="Personnaliser son tableau de bord ;&lt;br&gt;consulter ses notifications,&lt;br&gt;les salles et leurs matériels" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="630" width="262" height="63" as="geometry"/></mxCell><mxCell id="n_bords" value="Consulter les tableaux de bord&lt;br&gt;du parc et des remontées" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="707" width="262" height="48" as="geometry"/></mxCell><mxCell id="n_parc" value="Créer, modifier ou importer des matériels ;&lt;br&gt;gérer stocks et affectations ;&lt;br&gt;prévoir l&#x27;installation d&#x27;une salle" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="769" width="262" height="63" as="geometry"/></mxCell><mxCell id="n_suivi" value="Consulter les remontées de son périmètre,&lt;br&gt;leur PDF d&#x27;état des lieux,&lt;br&gt;les installations et les recensements" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="846" width="262" height="63" as="geometry"/></mxCell><mxCell id="n_traitement" value="Traiter les remontées ;&lt;br&gt;confirmer les installations dans ORION" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="923" width="262" height="48" as="geometry"/></mxCell><mxCell id="n_rigel" value="Lancer et réaliser les recensements ;&lt;br&gt;installer une salle avec RIGEL" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="985" width="262" height="48" as="geometry"/></mxCell><mxCell id="n_supervision" value="Superviser une salle" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="1047" width="262" height="36" as="geometry"/></mxCell><mxCell id="n_remontee" value="Créer une remontée ;&lt;br&gt;suivre ses remontées et leur PDF" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="1097" width="262" height="48" as="geometry"/></mxCell><mxCell id="n_administration" value="Gérer salles, étages, postes, applications,&lt;br&gt;règles de processus et comptes ;&lt;br&gt;supprimer un matériel du stock ;&lt;br&gt;demander u