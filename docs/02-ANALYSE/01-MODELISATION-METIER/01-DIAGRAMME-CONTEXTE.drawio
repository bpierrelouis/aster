<mxfile host="app.diagrams.net"><diagram id="06-diagramme-contexte-1" name="Diagramme de contexte de l&#x27;application ORION"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="769" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titre" value="Diagramme de contexte de l&#x27;application ORION" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="389" height="30" as="geometry"/></mxCell><mxCell id="n_gestionnaire" value="Gestionnaire" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="30" height="60" as="geometry"/></mxCell><mxCell id="n_formateur" value="Formateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="30" height="60" as="geometry"/></mxCell><mxCell id="n_administrateur" value="Administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="30" height="60" as="geometry"/></mxCell><mxCell id="n_superadmin" value="Super administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="670" width="30" height="60" as="geometry"/></mxCell><mxCell id="n_telephone" value="RIGEL, recensement mobile&lt;br&gt;sur le téléphone du gestionnaire&lt;br&gt;ou de l&#x27;administrateur" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="50" y="258" width="220" height="64" as="geometry"/></mxCell><mxCell id="n_orion" value="Application ORION" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="200" height="680" as="geometry"/></mxCell><mxCell id="n_mindefconnect" value="MindefConnect&lt;br&gt;service d&#x27;authentification" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1260" y="172" width="200" height="56" as="geometry"/></mxCell><mxCell id="n_administrationPostes" value="Solution d&#x27;administration&lt;br&gt;des postes Windows" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1260" y="492" width="200" height="56" as="geometry"/></mxCell><mxCell id="e1" value="Vers RIGEL : scan des salles et des matériels,&lt;br&gt;saisie d&#x27;un matériel inconnu&lt;br&gt;Vers le gestionnaire : avancement, matériels attendus" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_gestionnaire" target="n_telephone"><mxGeometry x="0.5183" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="100"/></Array></mxGeometry></mxCell><mxCell id="e2" value="Vers RIGEL : scan des salles et des matériels,&lt;br&gt;saisie d&#x27;un matériel inconnu&lt;br&gt;Vers l&#x27;administrateur : avancement, matériels attendus" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_administrateur" target="n_telephone"><mxGeometry x="0.5183" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="480"/></Array></mxGeometry></mxCell><mxCell id="e3" value="Vers ORION : constats&lt;br&gt;Vers RIGEL : installations et recensements en cours,&lt;br&gt;lieux et matériels à jour" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3382;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_telephone" target="n_orion"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Vers ORION : matériels, stocks, affectations, import JSON ;&lt;br&gt;prise en charge et traitement des remontées ;&lt;br&gt;confirmation des installations, recensements&lt;br&gt;Vers le gestionnaire : tableaux de bord du parc et des remontées ;&lt;br&gt;notifications des nouvelles remontées, des garanties&lt;br&gt;et des matériels à déplacer ; PDF d&#x27;état des lieux&lt;br&gt;produit à la demande ; QR code de liaison RIGEL" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0588;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_gestionnaire" target="n_orion"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Vers ORION : consultation des salles ; supervision d&#x27;une salle,&lt;br&gt;arrêt d&#x27;un processus utilisateur ; création d&#x27;une remontée&lt;br&gt;Vers le formateur : postes, processus utilisateur et alertes&lt;br&gt;de la salle ; suivi et PDF de ses remontées ;&lt;br&gt;notifications de leur évolution" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7941;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_formateur" target="n_orion"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Vers ORION : parc, salles, postes, applications,&lt;br&gt;règles de processus et comptes de son école ;&lt;br&gt;interventions sur les postes ; création, prise en charge&lt;br&gt;et traitement des remontées ; confirmation des installations,&lt;br&gt;recensements&lt;br&gt;Vers l&#x27;administrateur : tableaux de bord, supervision,&lt;br&gt;statistiques, PDF d&#x27;état des lieux, résultats des interventions ;&lt;br&gt;notifications des interventions, des processus interdits,&lt;br&gt;des garanties, des matériels à déplacer et de ses remontées ;&lt;br&gt;QR code de liaison RIGEL" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6176;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_administrateur" target="n_orion"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Vers ORION : actions de l&#x27;administrateur sur toutes les écoles,&lt;br&gt;sauf RIGEL ;&lt;br&gt;écoles, règles globales, comptes de super administrateur&lt;br&gt;Vers le super administrateur : données de l&#x27;école choisie&lt;br&gt;ou de toutes les écoles ; notifications de l&#x27;administrateur" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9412;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_superadmin" target="n_orion"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Vers MindefConnect : redirection des utilisateurs&lt;br&gt;pour authentification&lt;br&gt;Vers ORION : identité authentifiée" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2059;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_orion" target="n_mindefconnect"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Vers la solution : interventions (arrêt de processus,&lt;br&gt;installation, désinstallation, réinitialisation)&lt;br&gt;Vers ORION : système d&#x27;exploitation, sessions,&lt;br&gt;processus utilisateur et applications installées&lt;br&gt;des postes ; résultats des interventions" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.6765;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_orion" target="n_administrationPostes"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>