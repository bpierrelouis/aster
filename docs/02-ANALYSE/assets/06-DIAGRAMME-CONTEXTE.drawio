<mxfile host="app.diagrams.net"><diagram id="06-diagramme-contexte-1" name="Diagramme de contexte de l'application ORION"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1310" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titre" value="Diagramme de contexte de l&amp;#x27;application ORION" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="15.0" width="500.0" height="30.0" as="geometry"/></mxCell><mxCell id="n_orion" value="Application ORION" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860.0" y="330.0" width="260.0" height="880.0" as="geometry"/></mxCell><mxCell id="n_gestionnaire" value="Gestionnaire" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="165.0" y="340.0" width="30.0" height="60.0" as="geometry"/></mxCell><mxCell id="n_formateur" value="Formateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="165.0" y="600.0" width="30.0" height="60.0" as="geometry"/></mxCell><mxCell id="n_administrateur" value="Administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="165.0" y="860.0" width="30.0" height="60.0" as="geometry"/></mxCell><mxCell id="n_superadmin" value="Super administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;labelPerimeter=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="165.0" y="1120.0" width="30.0" height="60.0" as="geometry"/></mxCell><mxCell id="n_telephone" value="RIGEL, recensement mobile&lt;br&gt;sur le téléphone du gestionnaire" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60.0" y="90.0" width="240.0" height="80.0" as="geometry"/></mxCell><mxCell id="n_mindefconnect" value="MindefConnect&lt;br&gt;service d'authentification" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580.0" y="510.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="n_administrationPostes" value="Solution d'administration&lt;br&gt;des postes Windows" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580.0" y="950.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="e1" value="Vers RIGEL : scan des salles et des matériels,&lt;br&gt;saisie d'un matériel inconnu&lt;br&gt;Vers le gestionnaire : avancement, matériels attendus" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="n_gestionnaire" target="n_telephone"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Vers ORION : constats&lt;br&gt;Vers RIGEL : installations et recensements en cours,&lt;br&gt;lieux et matériels à jour" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n_telephone" target="n_orion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="130.0"/></Array></mxGeometry></mxCell><mxCell id="e3" value="Vers ORION : matériels, stocks, affectations, import JSON ;&lt;br&gt;prise en charge et traitement des remontées ;&lt;br&gt;confirmation des installations, recensements&lt;br&gt;Vers le gestionnaire : tableaux de bord du parc et des remontées ;&lt;br&gt;notifications des nouvelles remontées, des garanties&lt;br&gt;et des matériels à déplacer ; PDF d'état des lieux&lt;br&gt;produit à la demande ; QR code de liaison RIGEL" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;entryX=0;entryY=0.0455;" edge="1" parent="1" source="n_gestionnaire" target="n_orion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Vers ORION : consultation des salles ; supervision d'une salle,&lt;br&gt;arrêt d'un processus utilisateur ; création d'une remontée&lt;br&gt;Vers le formateur : postes, processus utilisateur et alertes&lt;br&gt;de la salle ; suivi et PDF de ses remontées ;&lt;br&gt;notifications de leur évolution" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;entryX=0;entryY=0.3409;" edge="1" parent="1" source="n_formateur" target="n_orion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Vers ORION : parc, salles, postes, applications,&lt;br&gt;règles de processus et comptes de son école ;&lt;br&gt;interventions sur les postes ; création d'une remontée&lt;br&gt;Vers l'administrateur : tableaux de bord, supervision,&lt;br&gt;statistiques, PDF d'état des lieux, résultats des interventions ;&lt;br&gt;notifications des interventions, des processus interdits&lt;br&gt;et de ses remontées" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;entryX=0;entryY=0.6364;" edge="1" parent="1" source="n_administrateur" target="n_orion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Vers ORION : actions de l'administrateur sur toutes les écoles ;&lt;br&gt;écoles, règles globales, comptes de super administrateur&lt;br&gt;Vers le super administrateur : données de l'école choisie&lt;br&gt;ou de toutes les écoles ; notifications de l'administrateur" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;entryX=0;entryY=0.9318;" edge="1" parent="1" source="n_superadmin" target="n_orion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Vers MindefConnect : redirection des utilisateurs&lt;br&gt;pour authentification&lt;br&gt;Vers ORION : identité authentifiée" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.2500;" edge="1" parent="1" source="n_orion" target="n_mindefconnect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Vers la solution : interventions (arrêt de processus,&lt;br&gt;installation, désinstallation, réinitialisation)&lt;br&gt;Vers ORION : système d'exploitation, sessions,&lt;br&gt;processus utilisateur et applications installées&lt;br&gt;des postes ; résultats des interventions" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.7500;" edge="1" parent="1" source="n_orion" target="n_administrationPostes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
