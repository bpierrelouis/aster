 déjà enregistré&lt;br&gt;dans une autre école" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="10.0" y="569.0" width="200" height="76" as="geometry"/></mxCell><mxCell id="n_confirmer" value="Confirmer l’import" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="47.5" y="685.0" width="125" height="38" as="geometry"/></mxCell><mxCell id="n_lire" value="Fichier lisible, non vide,&lt;br&gt;de taille admise ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="18.0" y="218.0" width="234" height="94" as="geometry"/></mxCell><mxCell id="n_rapprocher" value="Rapprocher les numéros de série du fichier&lt;br&gt;de ceux de tout le parc,&lt;br&gt;toutes écoles comprises" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="10.0" y="352.0" width="250" height="76" as="geometry"/></mxCell><mxCell id="n_presenter" value="Présenter les correspondances :&lt;br&gt;matériels déjà connus et transferts possibles" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="10.0" y="468.0" width="250" height="61" as="geometry"/></mxCell><mxCell id="n_fusionLigne" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="149.0" y="763.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="n_ligne" value="Reste-t-il une ligne&lt;br&gt;à traiter ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="72.0" y="833.0" width="184" height="94" as="geometry"/></mxCell><mxCell id="n_connu" value="Numéro de série&lt;br&gt;déjà connu ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="354.0" y="833.0" width="142" height="94" as="geometry"/></mxCell><mxCell id="n_controleLigne" value="Matériel complet et valide,&lt;br&gt;salle de l’école&lt;br&gt;de destination ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="594.0" y="986.0" width="242" height="134" as="geometry"/></mxCell><mxCell id="n_creer" value="Créer le matériel et lui attribuer un identifiant ORION" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="615.0" y="1194.0" width="200" height="46" as="geometry"/></mxCell><mxCell id="n_autreEcole" value="Matériel d’une autre école,&lt;br&gt;transfert validé, non cité par&lt;br&gt;une remontée en cours et non placé&lt;br&gt;hors service dans une salle ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="275.0" y="967.0" width="300" height="172" as="geometry"/></mxCell><mxCell id="n_transferer" value="Transférer le matériel&lt;br&gt;dans l’école de destination,&lt;br&gt;identifiant ORION conservé" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="335.0" y="1186.5" width="180" height="61" as="geometry"/></mxCell><mxCell id="n_ignorer" value="Ignorer la ligne :&lt;br&gt;déjà présente dans l’école,&lt;br&gt;répétée dans le fichier&lt;br&gt;ou transfert non retenu" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="73.0" y="1179.0" width="174" height="76" as="geo