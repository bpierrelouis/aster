"1" parent="lane_SYSTEME"><mxGeometry x="475" y="1345" width="30.0" height="30.0" as="geometry" /></mxCell><mxCell id="n_selectionner" value="Choisir l’école de destination et sélectionner le fichier JSON" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="70" y="144" width="260.0" height="52.0" as="geometry" /></mxCell><mxCell id="n_valider" value="Valider ou non le transfert de chaque matériel&lt;br&gt;déjà enregistré dans une autre école" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="70" y="546.5" width="260.0" height="67.0" as="geometry" /></mxCell><mxCell id="n_confirmer" value="Confirmer l’import" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="125" y="641.5" width="150.0" height="37.0" as="geometry" /></mxCell><mxCell id="n_lire" value="Fichier lisible, non vide,&lt;br&gt;de taille admise ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="366.8" y="187" width="246.4" height="86.0" as="geometry" /></mxCell><mxCell id="n_rapprocher" value="Rapprocher les numéros de série du fichier&lt;br&gt;de ceux de tout le parc, toutes écoles comprises" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="360" y="319" width="260.0" height="82.0" as="geometry" /></mxCell><mxCell id="n_presenter" value="Présenter les correspondances :&lt;br&gt;matériels déjà connus et transferts possibles" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="360" y="456.5" width="260.0" height="67.0" as="geometry" /></mxCell><mxCell id="n_ligne" value="Reste-t-il une ligne à traiter ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="350" y="790" width="280.0" height="80.0" as="geometry" /></mxCell><mxCell id="n_fusion" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="470" y="710" width="40" height="40" as="geometry" /></mxCell><mxCell id="n_connu" value="Numéro de série&lt;br&gt;déjà connu ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="395" y="927" width="190.0" height="86.0" as="geometry" /></mxCell><mxCell id="n_controleLigne" value="Matériel complet et valide,&lt;br&gt;salle de l’école de destination ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="350" y="1079.5" width="280.0" height="101.0" as="geometry" /></mxCell><mxCell id="n_creer" value="Créer le matériel et lui attribuer un identifiant ORION" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="40" y="1104" width="260.0" height="52.0" as="geometry" /></mxCell><mxCell id="n_autreEcole" value="Matériel d’une autre école, transfert validé,&lt;br&gt;non cité par une remontée en cours&lt;br&gt;et non placé hors service dans une salle ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="630" y="897" width="280.0" height="146.0" as="geometry" /></mxCell><mxCell id="n_transferer" value="Transférer le matériel dans l’école de destination,&lt;br&gt;identifiant ORION conservé" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="955" y="936.5" width="260.0" height="67.0" as="geometry" /></mxCell><mxCell id="n_ignorer" value="Ignorer la ligne : déjà présente dans l’école,&lt;br&gt;répétée dans le fichier ou transfert non retenu" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="640" y="1099" width="260.0" height="82.0" as="geometry" /></mxCell><mxCell id="n_refuser" value="Refuser l’import sans modifier le parc" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="360" y="1244" width="260.0" height="52.0" as="geometry" /></mxCell><mxCell id="n_bilan" value="Appliquer immédiatement l’import&lt;br&gt;et présenter le bilan : ajoutés, transférés, ignorés" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="40" y="796.5" width="260.0" height="67.0" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=none;endArrow=open;endSize=8;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_debut" target="n_selectionner"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=none;endArrow=open;endSize=8;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_selectionner" target="n_lire"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="240" /></Array></mxGeometry></mxCell><mxCell id="e3" value="[non]" style="edgeStyle=none;endArrow=open;endSize=8;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=