 y="1233.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="n_finRefus" value="Fin — import refusé" style="ellipse;html=1;shape=endState;aspect=fixed;fillColor=#000000;strokeColor=#000000;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="605.0" y="1523.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="n_selectionner" value="Choisir l’école de destination et sélectionner le fichier JSON" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="40.0" y="146.0" width="260.0" height="52.0" as="geometry"/></mxCell><mxCell id="n_valider" value="Valider ou non le transfert de chaque matériel&lt;br&gt;déjà enregistré dans une autre école" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="40.0" y="665.0" width="260.0" height="67.0" as="geometry"/></mxCell><mxCell id="n_confirmer" value="Confirmer l’import" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ACTEUR"><mxGeometry x="95.0" y="788.0" width="150.0" height="37.0" as="geometry"/></mxCell><mxCell id="n_lire" value="Fichier lisible, non vide,&lt;br&gt;de taille admise ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="496.8" y="254.0" width="246.4" height="86.0" as="geometry"/></mxCell><mxCell id="n_rapprocher" value="Rapprocher les numéros de série du fichier&lt;br&gt;de ceux de tout le parc, toutes écoles comprises" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="490.0" y="404.0" width="260.0" height="82.0" as="geometry"/></mxCell><mxCell id="n_presenter" value="Présenter les correspondances :&lt;br&gt;matériels déjà connus et transferts possibles" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="490.0" y="542.0" width="260.0" height="67.0" as="geometry"/></mxCell><mxCell id="n_ligne" value="Reste-t-il une ligne à traiter ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="480.0" y="881.0" width="280.0" height="80.0" as="geometry"/></mxCell><mxCell id="n_connu" value="Numéro de série&lt;br&gt;déjà connu ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="375.0" y="1025.0" width="190.0" height="86.0" as="geometry"/></mxCell><mxCell id="n_controleLigne" value="Matériel complet et valide,&lt;br&gt;salle de l’école de destination ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="285.0" y="1197.5" width="280.0" height="101.0" as="geometry"/></mxCell><mxCell id="n_creer" value="Créer le matériel et lui attribuer un identifiant ORION" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="40.0" y="1400.0" width="260.0" height="52.0" as="geometry"/></mxCell><mxCell id="n_autreEcole" value="Matériel d’une autre école, transfert validé,&lt;br&gt;non cité par une remontée en cours&lt;br&gt;et non placé hors service dans une salle ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_SYSTEME"><mxGeometry x="605.0" y="1175.0" width="280.0" height="146.0" as="geometry"/></mxCell><mxCell id="n_transferer" value="Transférer le matériel dans l’école de destination,&lt;br&gt;identifiant ORION conservé" style="rounded=1;arcSize=40;whit